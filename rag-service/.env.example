# Provider: "gemini" (default/production) or "ollama" (local/offline)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Gemini (production — recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama (local dev / offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# PostgreSQL (read-only user — run scripts/create_rag_reader.sql first)
POSTGRES_URL=postgresql+asyncpg://rag_reader:ragpass@localhost:5433/calories_tracker

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Security — must match RAG_INTERNAL_SECRET in NestJS .env
NESTJS_INTERNAL_SECRET=change-this-to-a-random-secret

# Service
RAG_SERVICE_PORT=8001
LOG_LEVEL=INFO

APP_NAME="Food Volume Estimation API"
APP_VERSION="0.2.0"
DEBUG=false

# Inference device: "cpu" (default, low RAM) or "cuda"
DEVICE=cpu

# Models (pre-trained, downloaded on first run)
YOLO_MODEL_PATH=yolov8n-seg.pt
FOOD_MODEL_ID=nateraw/food
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf

# Detection / preprocessing
MIN_CONF=0.25
MAX_IMAGE_SIDE=1024

# Physical calibration assumptions (cm)
PLATE_DIAMETER_CM=25.0
PLATE_DEPTH_CM=1.5
PLATE_THICKNESS_CM=0.2
